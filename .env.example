# Postgres connection string. Matches docker-compose.yml by default.
DATABASE_URL=postgres://retro:retro@localhost:5432/retro

# openssl rand -base64 32
AUTH_SECRET=

# Google OAuth web client. Redirect URI: {ORIGIN}/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Public origin, no trailing slash. Required behind a reverse proxy.
# Local dev can leave this as the URL you open in the browser.
ORIGIN=http://localhost:5173
AUTH_URL=http://localhost:5173
AUTH_TRUST_HOST=true

# Optional. When set, only verified Google accounts on this domain can sign in.
# Example: example.com
ALLOWED_EMAIL_DOMAIN=

# Optional. Local `npm run dev` only, and only on localhost.
# Lets you click through the UI before Google credentials exist.
# Production builds ignore this.
DEV_LOGIN_SECRET=

# Set to true on a single app instance to run SQL migrations before listen.
MIGRATE_ON_START=false
PORT=3000
